# Copy this file to .env and fill in values on the VPS.
# Never commit the real .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=generate-a-fernet-key-and-keep-it-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection settings
DB_NAME=petrodactal
DB_USER=petrodactal
DB_PASSWORD=replace-this-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Monitoring defaults (seconds)
MONITORING_INTERVAL=300
